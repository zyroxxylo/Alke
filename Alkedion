local function slider(pageName,label,min,max,def,cb)
    local r=Instance.new("Frame",pages[pageName])
    r.Size=UDim2.new(1,0,0,46); r.LayoutOrder=nextOrder(pageName)
    r.BackgroundColor3=PANEL; r.BorderSizePixel=0
    Instance.new("UICorner",r).CornerRadius=UDim.new(0,6)
    local lbl=Instance.new("TextLabel",r); lbl.Size=UDim2.new(1,-20,0,20); lbl.Position=UDim2.new(0,10,0,4)
    lbl.BackgroundTransparency=1; lbl.Text=label..": "..tostring(def); lbl.Font=Enum.Font.Gotham; lbl.TextSize=12; lbl.TextColor3=TEXT; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local track=Instance.new("Frame",r); track.Size=UDim2.new(1,-20,0,6); track.Position=UDim2.new(0,10,0,30)
    track.BackgroundColor3=Color3.fromRGB(55,55,65); track.BorderSizePixel=0; Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",track); fill.Size=UDim2.new((def-min)/(max-min),0,1,0); fill.BackgroundColor3=ACCENT; fill.BorderSizePixel=0
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local grabbing=false
    local function update(x)
        local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val=math.floor(min+rel*(max-min)+0.5)
        fill.Size=UDim2.new(rel,0,1,0); lbl.Text=label..": "..tostring(val)
        if cb then cb(val) end
    end
    track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then grabbing=true; update(i.Position.X) end end)
    UserInputService.InputChanged:Connect(function(i) if grabbing and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then update(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then grabbing=false end end)
end

