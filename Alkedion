-- LOGIC
local flyBody, flyGyro
function flySetup(on)
    local char=lp.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if on then
        local hum=char:FindFirstChildOfClass("Humanoid"); if hum then hum.PlatformStand=true end
        flyBody=Instance.new("BodyVelocity",hrp); flyBody.MaxForce=Vector3.new(1e5,1e5,1e5); flyBody.Velocity=Vector3.zero
        flyGyro=Instance.new("BodyGyro",hrp); flyGyro.MaxTorque=Vector3.new(1e5,1e5,1e5); flyGyro.P=1000
    else
        if flyBody then flyBody:Destroy(); flyBody=nil end
        if flyGyro then flyGyro:Destroy(); flyGyro=nil end
        local hum=char:FindFirstChildOfClass("Humanoid"); if hum then hum.PlatformStand=false end
    end
end

local hitboxCache={}; local espCache={}
function applyHitbox()
    for _,data in pairs(hitboxCache) do if data.weld then data.weld:Destroy() end; if data.part then data.part:Destroy() end end; hitboxCache={}
    if not state.hitboxOn or state.hitboxSize<=1 then return end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=lp and plr.Character then
            local hrp=plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hit=Instance.new("Part"); hit.Size=Vector3.new(state.hitboxSize,state.hitboxSize,state.hitboxSize)
                hit.Transparency=1; hit.CanCollide=false; hit.CanQuery=true; hit.Massless=true; hit.CFrame=hrp.CFrame; hit.Parent=plr.Character
                local weld=Instance.new("WeldConstraint"); weld.Part0=hrp; weld.Part1=hit; weld.Parent=hit
                hitboxCache[plr]={part=hit,weld=weld}
            end
        end
    end
end

function refreshESP()
    for _,entry in pairs(espCache) do if entry.highlight then entry.highlight:Destroy() end; if entry.billboard then entry.billboard:Destroy() end end; espCache={}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=lp and plr.Character then
            local entry={}
            if state.espOn then local h=Instance.new("Highlight",plr.Character); h.FillColor=ACCENT; h.OutlineColor=Color3.fromRGB(255,255,255); h.FillTransparency=0.6; entry.highlight=h end
            if state.nameOn then
                local head=plr.Character:FindFirstChild("Head")
                if head then
                    local bb=Instance.new("BillboardGui",head); bb.Size=UDim2.new(0,100,0,20); bb.StudsOffset=Vector3.new(0,2.5,0); bb.AlwaysOnTop=true
                    local lbl=Instance.new("TextLabel",bb); lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1; lbl.Text=plr.Name
                    lbl.Font=Enum.Font.GothamBold; lbl.TextSize=13; lbl.TextColor3=ACCENT; lbl.TextStrokeTransparency=0.3
                    entry.billboard=bb
                end
            end
            espCache[plr]=entry
        end
    end
end

local function findTarget(fov)
    local best,bestD=nil,math.huge; local mp=UserInputService:GetMouseLocation()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=lp and plr.Character then
            local p=plr.Character:FindFirstChild("Head")
            if p then
                local scr,on=Camera:WorldToViewportPoint(p.Position)
                if on then local d=(Vector2.new(scr.X,scr.Y)-mp).Magnitude; if d<fov and d<bestD then bestD=d; best=p end end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if state.speedOn and lp.Character then local h=lp.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=state.speedVal end end
    if state.noclipOn and lp.Character then for _,p in ipairs(lp.Character:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end end
    if state.flyOn and flyBody and flyBody.Parent then
        local dir=Vector3.zero; if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir+=Camera.CFrame.LookVector end; if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir-=Camera.CFrame.LookVector end; if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir-=Camera.CFrame.RightVector end; if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir+=Camera.CFrame.RightVector end
        if dir.Magnitude>0 then dir=dir.Unit end; flyBody.Velocity=dir*state.flySpeed; flyGyro.CFrame=Camera.CFrame
    end
    if state.aimOn then local tgt=findTarget(state.aimFOV); if tgt then Camera.CFrame=Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position,tgt.Position),state.aimSmooth) end end
    if state.aimAssistOn then
        local scoping = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or #UserInputService:GetTouches()>=2
        if scoping then local tgt=findTarget(state.aimFOV); if tgt then Camera.CFrame=Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position,tgt.Position),state.aimAssistStrength) end end
    end
    if state.showAimViewer then local px=math.floor(state.aimFOV); aimViewer.Size=UDim2.new(0,px,0,px); aimViewer.Position=UDim2.new(0.5,-px/2,0.5,-px/2) end
end)

RunService.Heartbeat:Connect(function()
    if state.autoRespawnOn and lp.Character then local h=lp.Character:FindFirstChildOfClass("Hu
